' =====================================================================
'  CAMBIOS_MATERIAL  v1.0  -  Regla externa iLogic (Inventor 2026) - COIMSER
'  Seguimiento de material entre EMISIONES de una fase (como el "comparar" de Tekla):
'   - Toma una FOTO de lo que hay hoy en el modelo (ya numerado con TEKLA_NUMERACION):
'       MARCAS     cantidad de cada marca de pieza y de conjunto
'       PERFILES   metros por perfil + grado        (W6x15 | A992 -> 41.0 m)
'       PLANCHAS   kg por espesor + grado           (PL9.5 | A36 -> 820 kg)
'   - La compara con una foto anterior (por defecto la ultima) y arma el Excel CAMBIOS:
'       NUEVA / AUMENTA / DISMINUYE / ELIMINADA / SIN CAMBIO con ANTES, AHORA y DIFERENCIA.
'   - Lo ELIMINADO aparece con AHORA = 0: se ve, pero NO suma en los totales (no se compra).
'     Si ya se habia cortado (historial de EXPORTAR_PLASMA) dice "SOBRANTE EN TALLER".
'  Uso: correr despues de TEKLA_NUMERACION y CUT_LIST, en cada emision de la fase.
'  Salida: <fase>\PLANOS\REPORTES\<ENSAMBLE>-CAMBIOS_MATERIAL_<fecha>.xlsx
'          fotos en PLANOS\REPORTES\_HISTORIAL\MATERIAL_<fecha>.csv  (nunca se borran)
'  Argumentos: silencioso, solo_foto (guarda la foto sin comparar)
' =====================================================================

Sub Main()
    silencioso = RuleArguments.Exists("silencioso")
    Dim asm As AssemblyDocument = TryCast(ThisApplication.ActiveDocument, AssemblyDocument)
    If asm Is Nothing Then
        MessageBox.Show("Abre el ensamble de la fase y ejecuta la regla ahi.", "CAMBIOS_MATERIAL")
        Exit Sub
    End If
    If EsGeneral(asm) Then
        MessageBox.Show("Este es el GENERAL. Usa EJECUTAR_FASES -> CAMBIOS_MATERIAL o abre una fase.", "CAMBIOS_MATERIAL")
        Exit Sub
    End If
    Dim nom As String = System.IO.Path.GetFileNameWithoutExtension(asm.FullFileName)
    Dim dirFase As String = System.IO.Path.GetDirectoryName(asm.FullFileName)

    Recorrer(asm.ComponentDefinition.Occurrences)
    If foto.Count = 0 Then
        Aviso("No encuentro piezas con MARCA en " & nom & ". Corre primero TEKLA_NUMERACION.")
        Exit Sub
    End If
    If sinMarca > 0 Then resumen.AppendLine("Ojo: " & sinMarca & " piezas sin MARCA (no entran). Corre TEKLA_NUMERACION.")

    Dim dirRep As String = System.IO.Path.Combine(dirFase, "PLANOS\REPORTES")
    System.IO.Directory.CreateDirectory(dirRep)
    If RuleArguments.Exists("solo_foto") Then
        GuardarFoto(dirRep, "MATERIAL", foto)
        Aviso("Foto guardada (" & foto.Count & " lineas).")
        Exit Sub
    End If
    Dim fAnt As String = ElegirFoto(dirRep, "MATERIAL", silencioso)
    Dim ant As Dictionary(Of String, Object()) = LeerFoto(fAnt)

    ' marcas ya cortadas (historial de plasma)
    Dim extra As New Dictionary(Of String, String)
    Dim cortadas As Dictionary(Of String, Integer) = LeerCortadas(System.IO.Path.Combine(dirFase, "PLANOS\PLASMA\_HISTORIAL_CORTE.csv"))
    For Each kv As KeyValuePair(Of String, Integer) In cortadas
        extra("MARCA|" & kv.Key) = "SOBRANTE EN TALLER (cortadas " & kv.Value & ")"
    Next

    ' se separa por grupo para tener hojas limpias
    Dim hojas As New List(Of String)(New String() {"MARCA", "PERFIL", "PLANCHA"})
    Dim titulos As New Dictionary(Of String, String)
    titulos("MARCA") = "CAMBIOS MARCAS"
    titulos("PERFIL") = "CAMBIOS PERFILES (m)"
    titulos("PLANCHA") = "CAMBIOS PLANCHAS (kg)"
    Dim res As New Dictionary(Of String, List(Of Object()))
    Dim total As Integer = 0
    For Each grp As String In hojas
        Dim a As New Dictionary(Of String, Object())
        Dim n As New Dictionary(Of String, Object())
        For Each kv As KeyValuePair(Of String, Object()) In ant
            If kv.Key.StartsWith(grp & "|") Then a(kv.Key) = kv.Value
        Next
        For Each kv As KeyValuePair(Of String, Object()) In foto
            If kv.Key.StartsWith(grp & "|") Then n(kv.Key) = kv.Value
        Next
        Dim nc As Integer = 0
        Dim filas As List(Of Object()) = Cambios(a, n, extra, nc)
        ' quitar el prefijo de grupo de la clave
        For i As Integer = 1 To filas.Count - 1
            filas(i)(0) = CStr(filas(i)(0)).Substring(grp.Length + 1)
        Next
        res(grp) = filas
        total += nc
    Next

    Dim fecha As String = DateTime.Now.ToString("yyyyMMdd_HHmm")
    Dim wb As Object = NuevoLibro()
    If wb Is Nothing Then
        For Each grp As String In hojas
            GuardarCsv(System.IO.Path.Combine(dirRep, nom & "-CAMBIOS_" & grp & "_" & fecha & ".csv"), res(grp))
        Next
    Else
        Dim primera As Boolean = True
        For Each grp As String In hojas
            Dim ws As Object = Hoja(wb, titulos(grp), primera)
            primera = False
            ws.Cells(1, 1).Value = titulos(grp) & " - " & nom & " - hoy " & DateTime.Now.ToString("yyyy-MM-dd HH:mm") & " vs " & If(fAnt = "", "(sin emision anterior)", System.IO.Path.GetFileNameWithoutExtension(fAnt))
            ws.Cells(2, 1).Value = "ELIMINADA = queda a la vista con AHORA 0 y no suma. Totales = solo lo vigente."
            Dim ult As Integer = Tabla(ws, 4, res(grp))
            ColorEstado(ws, 4, res(grp), 7)
            Try
                ws.Cells(ult + 2, 4).Value = "TOTAL"
                ws.Cells(ult + 2, 5).Formula = "=SUM(E5:E" & ult & ")"
                ws.Cells(ult + 2, 6).Formula = "=SUM(F5:F" & ult & ")"
            Catch
            End Try
        Next
        GuardarLibro(wb, System.IO.Path.Combine(dirRep, nom & "-CAMBIOS_MATERIAL_" & fecha & ".xlsx"))
    End If
    GuardarFoto(dirRep, "MATERIAL", foto)
    Aviso("Cambios respecto a " & If(fAnt = "", "(primera emision)", System.IO.Path.GetFileNameWithoutExtension(fAnt)) & ": " & total & vbCrLf & resumen.ToString() & vbCrLf & rutaSalida)
End Sub

Private silencioso As Boolean
Private resumen As New System.Text.StringBuilder
Private xl As Object
Private rutaSalida As String = ""
Private foto As New Dictionary(Of String, Object())
Private sinMarca As Integer = 0
Private vistos As New List(Of String)

Sub Recorrer(occs As Object)
    For Each o As ComponentOccurrence In occs
        Try
            If o.Suppressed Then Continue For
            Dim bs As BOMStructureEnum = o.BOMStructure
            If bs = BOMStructureEnum.kReferenceBOMStructure Or bs = BOMStructureEnum.kPurchasedBOMStructure Then Continue For
            Dim d As Document = o.Definition.Document
            If UProp(d, "EQUIPO").ToUpper() = "SI" Then Continue For
            Dim mk As String = UProp(d, "MARCA")
            If o.DefinitionDocumentType = DocumentTypeEnum.kAssemblyDocumentObject Then
                If mk <> "" AndAlso bs <> BOMStructureEnum.kPhantomBOMStructure Then Agregar("MARCA|" & mk, "CONJUNTO " & PropDT(d, "Description"), 1, "und")
                Recorrer(o.SubOccurrences)
            Else
                If bs = BOMStructureEnum.kPhantomBOMStructure Then Continue For
                If mk = "" Then
                    If Not vistos.Contains(d.FullFileName) Then
                        vistos.Add(d.FullFileName)
                        sinMarca += 1
                    End If
                    Continue For
                End If
                Dim desc As String = PropDT(d, "Description")
                Dim grado As String = UProp(d, "GRADO")
                Agregar("MARCA|" & mk, desc & " " & grado, 1, "und")
                Dim m As System.Text.RegularExpressions.Match = System.Text.RegularExpressions.Regex.Match(desc, "^PL\s*(\d+(?:[.,]\d+)?)", System.Text.RegularExpressions.RegexOptions.IgnoreCase)
                If m.Success Then
                    Dim kg As Double = Num(UProp(d, "PESO"))
                    If kg <= 0 Then
                        Try
                            kg = CType(d, PartDocument).ComponentDefinition.MassProperties.Mass
                        Catch
                        End Try
                    End If
                    Agregar("PLANCHA|PL" & m.Groups(1).Value.Replace(",", ".") & " | " & grado, "PLANCHA e=" & m.Groups(1).Value & " " & grado, kg, "kg")
                Else
                    Dim lg As Double = Num(UProp(d, "LONGITUD"))
                    If lg > 0 Then Agregar("PERFIL|" & desc & " | " & grado, desc & " " & grado, lg / 1000.0, "m")
                End If
            End If
        Catch
        End Try
    Next
End Sub

Sub Agregar(k As String, desc As String, q As Double, un As String)
    If foto.ContainsKey(k) Then
        foto(k)(1) = CDbl(foto(k)(1)) + q
    Else
        foto(k) = New Object() {desc, q, un}
    End If
End Sub

Function Num(s As String) As Double
    Dim v As Double = 0
    If s Is Nothing Then Return 0
    Dim m As System.Text.RegularExpressions.Match = System.Text.RegularExpressions.Regex.Match(s.Replace(",", "."), "-?\d+(\.\d+)?")
    If m.Success Then Double.TryParse(m.Value, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, v)
    Return v
End Function

' marca -> cantidad cortada (historial de EXPORTAR_PLASMA: fecha;ensamble;marca;cant;...;estado;...)
Function LeerCortadas(ruta As String) As Dictionary(Of String, Integer)
    Dim r As New Dictionary(Of String, Integer)
    If Not System.IO.File.Exists(ruta) Then Return r
    For Each ln As String In System.IO.File.ReadAllLines(ruta)
        Dim c() As String = ln.Split(";"c)
        If c.Length < 8 Then Continue For
        Dim q As Integer = 0
        If Not Integer.TryParse(c(3), q) OrElse q <= 0 Then Continue For
        If c(7).ToUpper().Contains("ANULADA") Then Continue For
        If r.ContainsKey(c(2)) Then r(c(2)) += q Else r(c(2)) = q
    Next
    Return r
End Function

Sub ColorEstado(ws As Object, filaIni As Integer, filas As List(Of Object()), colEst As Integer)
    Try
        For i As Integer = 1 To filas.Count - 1
            Dim e As String = CStr(filas(i)(colEst - 1))
            Dim c As Integer = -1
            If e.StartsWith("ELIMINADA") Then c = 13421823
            If e = "NUEVA" Then c = 13434828
            If e = "AUMENTA" Then c = 10092543
            If e = "DISMINUYE" Then c = 16772300
            If c >= 0 Then ws.Range(ws.Cells(filaIni + i, 1), ws.Cells(filaIni + i, colEst)).Interior.Color = c
        Next
    Catch
    End Try
End Sub

Sub Aviso(t As String)
    If Not silencioso Then MessageBox.Show(t, "CAMBIOS_MATERIAL")
End Sub

' ===================== comunes COIMSER =====================
Function Arg(n As String) As String
    Try
        If RuleArguments.Exists(n) Then Return CStr(RuleArguments.Value(n))
    Catch
    End Try
    Return ""
End Function

Function UProp(d As Document, n As String) As String
    Try
        Return CStr(d.PropertySets.Item("Inventor User Defined Properties").Item(n).Value).Trim()
    Catch
        Return ""
    End Try
End Function

Function PropDT(d As Document, n As String) As String
    Try
        Return CStr(d.PropertySets.Item("Design Tracking Properties").Item(n).Value).Trim()
    Catch
        Return ""
    End Try
End Function

Sub EscribirProp(d As Document, n As String, v As String)
    Dim ps As PropertySet = d.PropertySets.Item("Inventor User Defined Properties")
    Try
        ps.Item(n).Value = v
    Catch
        ps.Add(v, n)
    End Try
End Sub

' Carpeta de la obra: la primera hacia arriba que tiene _OBRA.txt
Function CarpetaObra(ruta As String) As String
    Dim x As String = System.IO.Path.GetDirectoryName(ruta)
    For i As Integer = 0 To 8
        If x Is Nothing OrElse x = "" Then Exit For
        If System.IO.File.Exists(System.IO.Path.Combine(x, "_OBRA.txt")) Then Return x
        x = System.IO.Path.GetDirectoryName(x)
    Next
    Return ""
End Function

Function EsGeneral(d As Document) As Boolean
    If UProp(d, "TIPO_ENSAMBLE").ToUpper() = "GENERAL" Then Return True
    Return System.IO.Path.GetFileNameWithoutExtension(d.FullFileName).ToUpper().EndsWith("-GENERAL")
End Function

' Fases del ensamble general: PLANTA -> ruta del .iam
Function FasesDe(g As AssemblyDocument) As Dictionary(Of String, String)
    Dim r As New Dictionary(Of String, String)
    For Each oc As ComponentOccurrence In g.ComponentDefinition.Occurrences
        Try
            Dim d As Document = oc.Definition.Document
            Dim pl As String = UProp(d, "PLANTA").ToUpper()
            If UProp(d, "TIPO_ENSAMBLE").ToUpper() = "PLANTA" AndAlso pl <> "" AndAlso Not r.ContainsKey(pl) Then r.Add(pl, d.FullFileName)
        Catch
        End Try
    Next
    Return r
End Function

Function Limpia(s As String) As String
    If s Is Nothing Then Return ""
    Return s.Replace(";", ",").Replace(vbCr, " ").Replace(vbLf, " ").Trim()
End Function

' ===================== Excel (si no hay Excel se guarda CSV) =====================
Function NuevoLibro() As Object
    Try
        xl = CreateObject("Excel.Application")
        xl.Visible = False
        xl.DisplayAlerts = False
        Dim wb As Object = xl.Workbooks.Add()
        Do While wb.Worksheets.Count > 1
            wb.Worksheets(wb.Worksheets.Count).Delete()
        Loop
        Return wb
    Catch
        xl = Nothing
        Return Nothing
    End Try
End Function

Function Hoja(wb As Object, nombre As String, primera As Boolean) As Object
    Dim ws As Object
    If primera Then
        ws = wb.Worksheets(1)
    Else
        ws = wb.Worksheets.Add(After:=wb.Worksheets(wb.Worksheets.Count))
    End If
    ws.Name = nombre
    Return ws
End Function

' Escribe una tabla (fila 1 = titulos) en una hoja; devuelve la ultima fila
Function Tabla(ws As Object, filaIni As Integer, filas As List(Of Object())) As Integer
    Dim r As Integer = filaIni
    For Each f() As Object In filas
        For c As Integer = 0 To f.Length - 1
            If f(c) Is Nothing Then Continue For
            ws.Cells(r, c + 1).Value = f(c)
        Next
        r += 1
    Next
    Try
        Dim nc As Integer = filas(0).Length
        ws.Range(ws.Cells(filaIni, 1), ws.Cells(filaIni, nc)).Font.Bold = True
        ws.Range(ws.Cells(filaIni, 1), ws.Cells(filaIni, nc)).Interior.Color = 14277081
        ws.Columns.AutoFit()
    Catch
    End Try
    Return r - 1
End Function

Sub GuardarLibro(wb As Object, ruta As String)
    Try
        If System.IO.File.Exists(ruta) Then System.IO.File.Delete(ruta)
    Catch
        ruta = System.IO.Path.Combine(System.IO.Path.GetDirectoryName(ruta), System.IO.Path.GetFileNameWithoutExtension(ruta) & "_" & DateTime.Now.ToString("HHmmss") & ".xlsx")
    End Try
    wb.Worksheets(1).Activate()
    wb.SaveAs(ruta, 51)
    wb.Close(False)
    xl.Quit()
    System.Runtime.InteropServices.Marshal.ReleaseComObject(wb)
    System.Runtime.InteropServices.Marshal.ReleaseComObject(xl)
    xl = Nothing
    rutaSalida = ruta
End Sub

' CSV de respaldo (;) cuando no hay Excel
Sub GuardarCsv(ruta As String, filas As List(Of Object()))
    Dim sb As New System.Text.StringBuilder()
    For Each f() As Object In filas
        Dim l As New List(Of String)
        For Each v As Object In f
            l.Add(If(v Is Nothing, "", Limpia(CStr(v))))
        Next
        sb.AppendLine(String.Join(";", l))
    Next
    System.IO.File.WriteAllText(ruta, sb.ToString(), System.Text.Encoding.UTF8)
    rutaSalida = ruta
End Sub

' ===================== FOTOS (historial para la hoja CAMBIOS) =====================
' Foto = CSV  clave;descripcion;cantidad;unidad  en <REPORTES>\_HISTORIAL\<PREFIJO>_<fecha>.csv
Sub GuardarFoto(dir As String, prefijo As String, datos As Dictionary(Of String, Object()))
    Dim h As String = System.IO.Path.Combine(dir, "_HISTORIAL")
    System.IO.Directory.CreateDirectory(h)
    Dim sb As New System.Text.StringBuilder()
    sb.AppendLine("CLAVE;DESCRIPCION;CANTIDAD;UNIDAD")
    For Each kv As KeyValuePair(Of String, Object()) In datos
        sb.AppendLine(Limpia(kv.Key) & ";" & Limpia(CStr(kv.Value(0))) & ";" & CDbl(kv.Value(1)).ToString(System.Globalization.CultureInfo.InvariantCulture) & ";" & Limpia(CStr(kv.Value(2))))
    Next
    System.IO.File.WriteAllText(System.IO.Path.Combine(h, prefijo & "_" & DateTime.Now.ToString("yyyyMMdd_HHmmss") & ".csv"), sb.ToString(), System.Text.Encoding.UTF8)
End Sub

' Fotos anteriores, la mas reciente primero
Function ListaFotos(dir As String, prefijo As String) As List(Of String)
    Dim l As New List(Of String)
    Dim h As String = System.IO.Path.Combine(dir, "_HISTORIAL")
    If System.IO.Directory.Exists(h) Then l.AddRange(System.IO.Directory.GetFiles(h, prefijo & "_*.csv"))
    l.Sort()
    l.Reverse()
    Return l
End Function

Function LeerFoto(ruta As String) As Dictionary(Of String, Object())
    Dim r As New Dictionary(Of String, Object())
    If ruta = "" OrElse Not System.IO.File.Exists(ruta) Then Return r
    Dim primera As Boolean = True
    For Each ln As String In System.IO.File.ReadAllLines(ruta, System.Text.Encoding.UTF8)
        If primera Then
            primera = False
            Continue For
        End If
        Dim c() As String = ln.Split(";"c)
        If c.Length < 4 OrElse c(0) = "" Then Continue For
        Dim q As Double = 0
        Double.TryParse(c(2), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, q)
        r(c(0)) = New Object() {c(1), q, c(3)}
    Next
    Return r
End Function

' Elige con que foto comparar (por defecto la ultima). Devuelve "" si no hay.
Function ElegirFoto(dir As String, prefijo As String, silencioso As Boolean) As String
    Dim l As List(Of String) = ListaFotos(dir, prefijo)
    If l.Count = 0 Then Return ""
    If silencioso OrElse l.Count = 1 Then Return l(0)
    Dim ops As New List(Of String)
    For Each f As String In l
        ops.Add(System.IO.Path.GetFileNameWithoutExtension(f))
    Next
    Dim r As String = InputListBox("Comparar con la emision / corrida de:", ops, ops(0), prefijo, "Foto anterior")
    If r Is Nothing OrElse r = "" Then Return l(0)
    For Each f As String In l
        If System.IO.Path.GetFileNameWithoutExtension(f) = r Then Return f
    Next
    Return l(0)
End Function

' Filas de la hoja CAMBIOS. extraEliminada(clave) -> texto adicional (ej. SOBRANTE EN TALLER)
Function Cambios(ant As Dictionary(Of String, Object()), act As Dictionary(Of String, Object()), extraEliminada As Dictionary(Of String, String), ByRef nCambios As Integer) As List(Of Object())
    Dim filas As New List(Of Object())
    filas.Add(New Object() {"CLAVE", "DESCRIPCION", "UNIDAD", "ANTES", "AHORA", "DIFERENCIA", "ESTADO"})
    Dim claves As New List(Of String)(act.Keys)
    For Each k As String In ant.Keys
        If Not act.ContainsKey(k) Then claves.Add(k)
    Next
    claves.Sort()
    nCambios = 0
    For Each k As String In claves
        Dim qa As Double = 0
        Dim qn As Double = 0
        Dim desc As String = ""
        Dim un As String = ""
        If ant.ContainsKey(k) Then
            qa = CDbl(ant(k)(1))
            desc = CStr(ant(k)(0))
            un = CStr(ant(k)(2))
        End If
        If act.ContainsKey(k) Then
            qn = CDbl(act(k)(1))
            desc = CStr(act(k)(0))
            un = CStr(act(k)(2))
        End If
        Dim est As String
        If ant.Count = 0 Then
            est = "PRIMERA EMISION"
        ElseIf Not ant.ContainsKey(k) Then
            est = "NUEVA"
        ElseIf Not act.ContainsKey(k) Then
            est = "ELIMINADA (no se compra)"
            If extraEliminada IsNot Nothing AndAlso extraEliminada.ContainsKey(k) Then est &= " - " & extraEliminada(k)
        ElseIf Math.Abs(qn - qa) < 0.0005 Then
            est = "SIN CAMBIO"
        ElseIf qn > qa Then
            est = "AUMENTA"
        Else
            est = "DISMINUYE"
        End If
        If est <> "SIN CAMBIO" AndAlso est <> "PRIMERA EMISION" Then nCambios += 1
        filas.Add(New Object() {k, desc, un, Math.Round(qa, 3), Math.Round(qn, 3), Math.Round(qn - qa, 3), est})
    Next
    Return filas
End Function
