' =====================================================================
'  TITULO_PLANO  -  Regla externa iLogic para planos (.idw / .dwg)
'  COIMSER
'
'  Ademas pone la MARCA en cada globo (estilo COIMSER-MARCA).
'  Escribe el iProperty "Titulo" del plano (es el campo que muestra el
'  cajetin ISO/DIN de Inventor):
'   - 1 modelo en el plano (ipt o iam)  -> nombre del archivo del modelo
'   - varias piezas (ipt) en el plano   -> "HABILITADO DE <ensamble>"
'   - varias vistas con un iam          -> nombre del ensamble
'  El ensamble se toma de la propiedad ENSAMBLE que pone TEKLA_NUMERACION;
'  si no existe, se busca por la estructura de carpetas de Frame Generator
'  (...\PORT-001\Frame\pieza.ipt -> PORT-001.iam).
'
'  Uso recomendado: Desencadenadores de eventos -> "Antes de guardar documento"
'  para todos los planos.
' =====================================================================
Imports System.Collections.Generic

Sub Main()
    Dim dw As DrawingDocument = TryCast(ThisDoc.Document, DrawingDocument)
    If dw Is Nothing Then
        MessageBox.Show("Ejecuta esta regla con un plano abierto (.idw / .dwg).", "TITULO_PLANO")
        Exit Sub
    End If

    Dim piezas As New List(Of Document)
    Dim ensambles As New List(Of Document)
    For Each d As Document In dw.ReferencedDocuments
        If d.DocumentType = DocumentTypeEnum.kPartDocumentObject Then piezas.Add(d)
        If d.DocumentType = DocumentTypeEnum.kAssemblyDocumentObject Then ensambles.Add(d)
    Next
    If piezas.Count + ensambles.Count = 0 Then Exit Sub

    Dim titulo As String
    If piezas.Count + ensambles.Count = 1 Then
        Dim m As Document = If(piezas.Count = 1, piezas(0), ensambles(0))
        titulo = System.IO.Path.GetFileNameWithoutExtension(m.FullFileName)
    ElseIf ensambles.Count >= 1 Then
        titulo = System.IO.Path.GetFileNameWithoutExtension(ensambles(0).FullFileName)
    Else
        titulo = "HABILITADO DE " & BuscarEnsamble(piezas)
    End If

    dw.PropertySets.Item("Inventor Summary Information").Item("Title").Value = titulo.ToUpper()
    ' El rotulo COIMSER muestra el NOMBRE DE HOJA en CONTENIDO: en planos de una hoja = titulo
    If dw.Sheets.Count = 1 Then
        Try
            dw.Sheets.Item(1).Name = titulo.ToUpper()
        Catch
        End Try
    End If

    ' Globos: muestran la MARCA de la pieza (como Tekla) en lugar del numero de elemento
    Dim nGlobos As Integer = 0
    For Each hoja As Sheet In dw.Sheets
        For Each b As Balloon In hoja.Balloons
            For Each vs As BalloonValueSet In b.BalloonValueSets
                Try
                    Dim d As Document = vs.ReferencedRow.BOMRow.ComponentDefinitions.Item(1).Document
                    Dim m As String = CStr(d.PropertySets.Item("Inventor User Defined Properties").Item("MARCA").Value).Trim()
                    If m <> "" Then
                        If vs.OverrideValue <> m Then vs.OverrideValue = m
                        nGlobos += 1
                    End If
                Catch
                End Try
            Next
        Next
    Next

    If Not RuleArguments.Exists("silencioso") Then MessageBox.Show("Titulo del plano: " & titulo.ToUpper() & vbCrLf & "Globos con marca: " & nGlobos, "TITULO_PLANO")
End Sub

Function BuscarEnsamble(piezas As List(Of Document)) As String
    ' 1) Propiedad ENSAMBLE escrita por TEKLA_NUMERACION
    For Each p As Document In piezas
        Try
            Dim v As String = CStr(p.PropertySets.Item("Inventor User Defined Properties").Item("ENSAMBLE").Value).Trim()
            If v <> "" Then Return v
        Catch
        End Try
    Next
    ' 2) Estructura de Frame Generator: <carpeta>\<NOMBRE>\Frame\pieza.ipt  ->  <carpeta>\<NOMBRE>.iam
    Dim dir As String = System.IO.Path.GetDirectoryName(piezas(0).FullFileName)
    For i As Integer = 1 To 3
        Dim padre As System.IO.DirectoryInfo = System.IO.Directory.GetParent(dir)
        If padre Is Nothing Then Exit For
        Dim cand As String = System.IO.Path.Combine(padre.FullName, System.IO.Path.GetFileName(dir) & ".iam")
        If System.IO.File.Exists(cand) Then Return System.IO.Path.GetFileNameWithoutExtension(cand)
        dir = padre.FullName
    Next
    ' 3) Sin datos: nombre de la carpeta de la primera pieza
    Return System.IO.Path.GetFileName(System.IO.Path.GetDirectoryName(piezas(0).FullFileName))
End Function
