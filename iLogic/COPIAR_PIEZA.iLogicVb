' =====================================================================
'  COPIAR_PIEZA  v1.1  -  Regla externa iLogic (Inventor 2026) - COIMSER
'  Copia UNA pieza (.ipt) para modificarla sin tocar la original, dentro del orden de la obra:
'
'     MAJ-ALM-BA-001\Piezas\MAJ-ALM-BA-001-PL-002.ipt
'        ->  MAJ-ALM-BA-001\Piezas\MAJ-ALM-BA-001-PL-005.ipt   (siguiente numero libre)
'
'  - Seleccionas la pieza en el ensamble (o la eliges al correr la regla).
'  - La copia va a la carpeta Piezas del conjunto donde esta la pieza, con su nombre en serie
'    (mismo prefijo PL / CH / MQ ... que la original) -> nombre unico para Vault.
'  - En la copia borra MARCA y datos de numeracion (TEKLA le da su propia marca), pone
'    Part Number = nombre del archivo y COPIA_DE = pieza original.
'  - REEMPLAZAR: esa instancia (solo esa) pasa a usar la copia.   INSERTAR: la copia se agrega
'    aparte, en la misma posicion que la original (muevela a su sitio).
'  - Pieza ASOCIADA (skeleton / solido de forma / otra pieza): la copia puede MANTENER el
'    vinculo (sigue cambiando con su fuente) o quedar INDEPENDIENTE (vinculo roto, forma fija).
'  - No copia piezas de biblioteca (Content Center) ni referencias. Un perfil de Frame Generator
'    copiado queda como pieza normal (ya no lo controla el Frame).
'  v1.1 - INSERTAR deja la copia LIBRE (antes copiaba el 'fijo' de la original).
'  Argumentos (pruebas): silencioso, objeto=<ocurrencia o archivo>, accion=reemplazar|insertar,
'     vinculo=mantener|independiente
' =====================================================================
Imports System.Collections.Generic

Sub Main()
    Dim top As AssemblyDocument = Nothing
    Try
        top = TryCast(ThisDoc.Document, AssemblyDocument)
    Catch
    End Try
    If top Is Nothing Then top = TryCast(ThisApplication.ActiveDocument, AssemblyDocument)
    If top Is Nothing Then
        MessageBox.Show("Abre el ensamble (conjunto o fase), selecciona la pieza y ejecuta la regla.", "COPIAR_PIEZA")
        Exit Sub
    End If
    silencioso = RuleArguments.Exists("silencioso")

    ' ---------- pieza a copiar ----------
    Dim occ As ComponentOccurrence = Nothing
    Dim nomO As String = Arg("objeto")
    If nomO <> "" Then
        occ = BuscarOcc(top.ComponentDefinition.Occurrences, nomO.ToLower())
    Else
        Try
            For Each o As Object In top.SelectSet
                Dim oc As ComponentOccurrence = TryCast(o, ComponentOccurrence)
                If oc IsNot Nothing AndAlso oc.DefinitionDocumentType = DocumentTypeEnum.kPartDocumentObject Then
                    occ = oc
                    Exit For
                End If
            Next
        Catch
        End Try
        If occ Is Nothing AndAlso Not silencioso Then
            Try
                occ = CType(ThisApplication.CommandManager.Pick(SelectionFilterEnum.kAssemblyLeafOccurrenceFilter, "Selecciona la pieza a copiar (Esc = cancelar)"), ComponentOccurrence)
            Catch
            End Try
        End If
    End If
    If occ Is Nothing Then Exit Sub
    If occ.DefinitionDocumentType <> DocumentTypeEnum.kPartDocumentObject Then
        MessageBox.Show("Elige una PIEZA (.ipt). Para copiar un conjunto completo usa COPIAR_CONJUNTO.", "COPIAR_PIEZA")
        Exit Sub
    End If
    Dim src As PartDocument = CType(occ.Definition.Document, PartDocument)
    Dim cdSrc As PartComponentDefinition = src.ComponentDefinition
    If cdSrc.IsContentMember Then
        MessageBox.Show(System.IO.Path.GetFileName(src.FullFileName) & " es de la biblioteca (Content Center): no se copia." & vbCrLf & "Inserta otra instancia o cambia su tamano desde la biblioteca.", "COPIAR_PIEZA")
        Exit Sub
    End If
    If UProp(src, "REFERENCIA").ToUpper() = "SI" Then
        MessageBox.Show(System.IO.Path.GetFileName(src.FullFileName) & " es una REFERENCIA (no se fabrica): no se copia con esta regla.", "COPIAR_PIEZA")
        Exit Sub
    End If

    ' ---------- ensamble donde vive la pieza ----------
    Dim nat As ComponentOccurrence = occ
    Try
        If TypeOf occ Is ComponentOccurrenceProxy Then nat = CType(occ, ComponentOccurrenceProxy).NativeObject
    Catch
    End Try
    Dim padre As AssemblyDocument = top
    Try
        padre = CType(nat.Parent.Document, AssemblyDocument)
    Catch
    End Try
    If padre.FullFileName = "" Then
        MessageBox.Show("Guarda primero el ensamble " & padre.DisplayName & ".", "COPIAR_PIEZA")
        Exit Sub
    End If
    Dim esFrame As Boolean = False
    Try
        esFrame = src.DocumentInterests.HasInterest("{AC211AE0-A7A5-4589-916D-81C529DA6D17}")
    Catch
    End Try
    Dim asociada As Boolean = (UProp(src, "ASOCIADA").ToUpper() = "SI")
    Dim nDeriv As Integer = 0
    Try
        nDeriv = cdSrc.ReferenceComponents.DerivedPartComponents.Count
    Catch
    End Try

    ' ---------- opciones ----------
    Dim accion As String = Arg("accion").ToLower()
    If accion = "" Then
        If silencioso Then
            accion = "reemplazar"
        Else
            Dim ls As New List(Of String)
            ls.Add("REEMPLAZAR - esta instancia pasa a usar la copia (las demas siguen con la original)")
            ls.Add("INSERTAR - agregar la copia aparte (queda en la misma posicion)")
            Dim r As String = InputListBox("Copiar " & System.IO.Path.GetFileName(src.FullFileName) & vbCrLf & "en " & NomSin(padre), ls, ls(0), "COPIAR_PIEZA", "Que hago con la copia?")
            If r Is Nothing OrElse r = "" Then Exit Sub
            accion = If(r.StartsWith("REEMPLAZAR"), "reemplazar", "insertar")
        End If
    End If
    Dim vinculo As String = Arg("vinculo").ToLower()
    If nDeriv = 0 Then
        vinculo = ""
    ElseIf vinculo = "" Then
        If silencioso Then
            vinculo = "mantener"
        Else
            Dim ls As New List(Of String)
            ls.Add("MANTENER el vinculo (la copia sigue cambiando con " & FuenteDe(src) & ")")
            ls.Add("INDEPENDIENTE (se rompe el vinculo: la copia queda con su forma actual)")
            Dim r As String = InputListBox("La pieza esta asociada / derivada de otra geometria:", ls, ls(0), "COPIAR_PIEZA", "Vinculo")
            If r Is Nothing OrElse r = "" Then Exit Sub
            vinculo = If(r.StartsWith("MANTENER"), "mantener", "independiente")
        End If
    End If

    ' ---------- nombre y carpeta ----------
    Dim nomPadre As String = NomSin(padre)
    Dim carpeta As String = System.IO.Path.Combine(CarpetaHija(padre), "Piezas")
    System.IO.Directory.CreateDirectory(carpeta)
    Dim pref As String = Prefijo(src)
    Dim n As Integer = 1
    Dim ruta As String
    Do
        ruta = System.IO.Path.Combine(carpeta, nomPadre & "-" & pref & "-" & n.ToString("000") & ".ipt")
        If Not System.IO.File.Exists(ruta) AndAlso Not Abierto(ruta) Then Exit Do
        n += 1
    Loop

    ' ---------- copiar ----------
    Try
        src.SaveAs(ruta, True)
    Catch ex As Exception
        MessageBox.Show("No se pudo copiar a" & vbCrLf & ruta & vbCrLf & vbCrLf & ex.Message, "COPIAR_PIEZA")
        Exit Sub
    End Try
    Dim cp As PartDocument = CType(ThisApplication.Documents.Open(ruta, False), PartDocument)
    Dim rotos As Integer = 0
    If vinculo = "independiente" Then
        For Each dc As DerivedPartComponent In cp.ComponentDefinition.ReferenceComponents.DerivedPartComponents
            Try
                dc.BreakLinkToFile()
                rotos += 1
            Catch
            End Try
        Next
        If asociada Then
            EscribirProp(cp, "ASOCIADA", "NO")
            EscribirProp(cp, "VINCULO_ROTO", "SI")
        End If
    End If
    ' numeracion fuera; copia identificada
    For Each pn As String In New String() {"MARCA", "MARCA_ANTERIOR", "CONJUNTO", "ENSAMBLE", "PADRE", "RUTA", "NIVEL", "PERTENECE_A", "BLOQUEADO", "TAG", "TAG_LOCAL", "TAGS", "CONGELADA_EN"}
        If UProp(cp, pn) <> "" Then EscribirProp(cp, pn, "")
    Next
    EscribirProp(cp, "COPIA_DE", NomSin(src))
    Dim plPadre As String = UProp(padre, "PLANTA")
    If plPadre <> "" AndAlso UProp(cp, "PLANTA") <> "" Then EscribirProp(cp, "PLANTA", plPadre)
    Try
        cp.PropertySets.Item("Design Tracking Properties").Item("Part Number").Value = System.IO.Path.GetFileNameWithoutExtension(ruta)
    Catch
    End Try
    cp.Save2(False)

    ' ---------- poner en el ensamble ----------
    Dim hecho As String = ""
    Try
        If accion = "reemplazar" Then
            nat.Replace(ruta, False)
            hecho = "Reemplazada en " & nomPadre & " la instancia " & nat.Name & " (las demas instancias siguen con la original)."
        Else
            Dim nueva As ComponentOccurrence = padre.ComponentDefinition.Occurrences.Add(ruta, nat.Transformation)
            Try
                nueva.Grounded = False
            Catch
            End Try
            hecho = "Insertada en " & nomPadre & " como " & nueva.Name & ", LIBRE (no fija), en la misma posicion que la original: muevela o restringela a su sitio."
        End If
    Catch ex As Exception
        hecho = "La copia se creo pero no se pudo poner en " & nomPadre & " (" & ex.Message & "). Insertala a mano."
    End Try
    Try
        cp.Close(True)
    Catch
    End Try

    bitacora.AppendLine("Copia: " & System.IO.Path.GetFileName(ruta))
    bitacora.AppendLine("De:    " & System.IO.Path.GetFileName(src.FullFileName) & "   (la original no se toca)")
    bitacora.AppendLine("En:    " & carpeta)
    bitacora.AppendLine(hecho)
    If nDeriv > 0 Then bitacora.AppendLine(If(vinculo = "independiente", "Vinculo ROTO (" & rotos & "): la copia ya no cambia con " & FuenteDe(src) & ".", "Vinculo MANTENIDO con " & FuenteDe(src) & "."))
    If esFrame Then bitacora.AppendLine("Era un perfil de Frame Generator: la copia es una pieza normal (el Frame ya no la controla).")
    bitacora.AppendLine("MARCA borrada: corre TEKLA_NUMERACION para que reciba la suya. Guarda el ensamble.")
    Try
        System.IO.File.WriteAllText(System.IO.Path.Combine(carpeta, "_ultima_pieza.txt"), ruta)
    Catch
    End Try
    Aviso(bitacora.ToString())
    If Not silencioso AndAlso accion = "reemplazar" Then
        ' deja seleccionada la copia para que la edites
        Try
            top.SelectSet.Clear()
        Catch
        End Try
    End If
End Sub

Private silencioso As Boolean
Private bitacora As New System.Text.StringBuilder

' Prefijo de la serie: el de la original (...-PL-002 -> PL); si no tiene, segun su tipo
Function Prefijo(p As PartDocument) As String
    Dim m As System.Text.RegularExpressions.Match = System.Text.RegularExpressions.Regex.Match(NomSin(p).ToUpper(), "-([A-Z]{1,4})-\d{2,4}$")
    If m.Success Then Return m.Groups(1).Value
    If p.SubType = "{9C464203-9BAE-11D3-8BAD-0060B0CE6BB4}" Then Return "CH"
    Dim nat As String = UProp(p, "NATURALEZA").ToUpper()
    If nat.Contains("MECANIZ") OrElse UProp(p, "CODIGO").ToLower() = "mq" Then Return "MQ"
    If nat.Contains("PLANCHA") Then Return "PL"
    If UProp(p, "PERFIL") <> "" Then Return "PF"
    Return "PZ"
End Function

Function FuenteDe(p As PartDocument) As String
    Dim f As String = UProp(p, "DEPENDE_DE")
    If f <> "" Then Return System.IO.Path.GetFileName(f)
    Try
        Return System.IO.Path.GetFileName(p.ComponentDefinition.ReferenceComponents.DerivedPartComponents.Item(1).ReferencedDocumentDescriptor.FullDocumentName)
    Catch
    End Try
    Return "su fuente"
End Function

Function Abierto(ruta As String) As Boolean
    For Each x As Document In ThisApplication.Documents
        If x.FullFileName.ToLower() = ruta.ToLower() Then Return True
    Next
    Return False
End Function

Function BuscarOcc(occs As Object, nom As String) As ComponentOccurrence
    For Each o As ComponentOccurrence In occs
        Dim f As String = ""
        Try
            f = System.IO.Path.GetFileName(o.Definition.Document.FullFileName).ToLower()
        Catch
        End Try
        If o.Name.ToLower() = nom OrElse f = nom OrElse System.IO.Path.GetFileNameWithoutExtension(f) = nom Then Return o
        If o.DefinitionDocumentType = DocumentTypeEnum.kAssemblyDocumentObject Then
            Dim r As ComponentOccurrence = BuscarOcc(o.SubOccurrences, nom)
            If r IsNot Nothing Then Return r
        End If
    Next
    Return Nothing
End Function

Function NomSin(d As Document) As String
    Return System.IO.Path.GetFileNameWithoutExtension(d.FullFileName)
End Function

Function Arg(n As String) As String
    Try
        If RuleArguments.Exists(n) Then Return CStr(RuleArguments.Value(n))
    Catch
    End Try
    Return ""
End Function

Function UProp(d As Document, n As String) As String
    Try
        Return CStr(d.PropertySets.Item("Inventor User Defined Properties").Item(n).Value).Trim()
    Catch
    End Try
    Return ""
End Function

Sub EscribirProp(d As Document, n As String, v As String)
    Dim ps As PropertySet = d.PropertySets.Item("Inventor User Defined Properties")
    Try
        ps.Item(n).Value = v
    Catch
        ps.Add(v, n)
    End Try
End Sub

Sub Aviso(t As String)
    If Not silencioso Then MessageBox.Show(t, "COPIAR_PIEZA")
End Sub

' Carpeta para los hijos de un ensamble: <carpeta>\<NOMBRE>\ ; una FASE que ya vive en su propia
' carpeta (<obra>\<COD>-<FASE>\<COD>-<FASE>.iam) usa esa misma carpeta.
Function CarpetaHija(d As Document) As String
    Dim dir As String = System.IO.Path.GetDirectoryName(d.FullFileName)
    Dim nom As String = System.IO.Path.GetFileNameWithoutExtension(d.FullFileName)
    Dim tipoEns As String = ""
    Try
        tipoEns = CStr(d.PropertySets.Item("Inventor User Defined Properties").Item("TIPO_ENSAMBLE").Value).Trim().ToUpper()
    Catch
    End Try
    If tipoEns = "PLANTA" AndAlso System.IO.Path.GetFileName(dir).ToUpper() = nom.ToUpper() Then Return dir
    Return System.IO.Path.Combine(dir, nom)
End Function
