' =====================================================================
'  PERFIL_A_OBRA  v1.2  -  Regla externa iLogic (Inventor 2026) - COIMSER
'  Pasa perfiles de CONTENT CENTER colocados en ESTANDAR a piezas PERSONALIZADAS de la obra:
'
'     Content Center Files\...\AISC - W 8x31 - 1500.ipt   (compartido, solo lectura, fuera de la obra)
'        ->  PLCAY-CP1-C-001\Piezas\PLCAY-CP1-C-001-PF-001.ipt   (de la obra, editable)
'
'  - Seleccionas los perfiles en el conjunto (o en la fase) y ejecutas la regla. Sin seleccion,
'    revisa TODO el ensamble abierto y te pregunta.
'  - Se crea el miembro PERSONALIZADO de la misma familia, tamano y LONGITUD, con nombre en
'    serie (prefijo PF) en la carpeta Piezas del ensamble que contiene al perfil, y se REEMPLAZA
'    en su sitio (las restricciones se conservan).
'  - Varias instancias del mismo perfil y largo en el mismo ensamble usan una sola pieza nueva.
'  - Conserva familia, tamano y material: TEKLA_NUMERACION y CUT_LIST los describen igual
'    (W8x31, L 1500). Ya puedes hacerle destajes, cortes y agujeros.
'  - Solo perfiles (familias con longitud G_L): la perneria y otros comerciales NO se tocan.
'  Argumentos (pruebas): silencioso, todos=SI
' =====================================================================
Imports System.Collections.Generic

Sub Main()
    silencioso = RuleArguments.Exists("silencioso")
    Dim top As AssemblyDocument = Nothing
    Try
        top = TryCast(ThisDoc.Document, AssemblyDocument)
    Catch
    End Try
    If top Is Nothing Then top = TryCast(ThisApplication.ActiveDocument, AssemblyDocument)
    If top Is Nothing Then
        MessageBox.Show("Abre el ensamble (conjunto o fase), selecciona los perfiles de Content Center y ejecuta la regla.", "PERFIL_A_OBRA")
        Exit Sub
    End If

    ' ---------- perfiles a convertir ----------
    Dim occs As New List(Of ComponentOccurrence)
    If Arg("todos").ToUpper() <> "SI" Then
        Try
            For Each o As Object In top.SelectSet
                Dim oc As ComponentOccurrence = TryCast(o, ComponentOccurrence)
                If oc IsNot Nothing AndAlso EsPerfilCC(oc) Then occs.Add(Nativa(oc))
            Next
        Catch
        End Try
    End If
    If occs.Count = 0 Then
        Dim todas As New List(Of ComponentOccurrence)
        Juntar(top.ComponentDefinition.Occurrences, todas)
        If todas.Count = 0 Then
            If Not silencioso Then MessageBox.Show("No hay perfiles de Content Center en estandar en " & top.DisplayName & ".", "PERFIL_A_OBRA")
            Exit Sub
        End If
        If Not silencioso AndAlso Arg("todos").ToUpper() <> "SI" Then
            If MessageBox.Show("No seleccionaste perfiles. Hay " & todas.Count & " perfiles de Content Center en estandar en " & top.DisplayName & "." & vbCrLf & "Pasarlos TODOS a piezas de la obra?", "PERFIL_A_OBRA", MessageBoxButtons.YesNo, MessageBoxIcon.Question) <> DialogResult.Yes Then Exit Sub
        End If
        occs = todas
    End If

    Dim cc As ContentCenter = ThisApplication.ContentCenter
    Dim hechos As New Dictionary(Of String, String)(StringComparer.OrdinalIgnoreCase)   ' miembro|ensamble -> pieza nueva
    Dim lineas As New List(Of String)
    Dim errores As New List(Of String)
    Dim nRemp As Integer = 0
    For Each oc As ComponentOccurrence In occs
        Try
            Dim src As PartDocument = CType(oc.Definition.Document, PartDocument)
            Dim padre As AssemblyDocument = CType(oc.Parent.Document, AssemblyDocument)
            If padre.FullFileName = "" Then
                errores.Add(oc.Name & ": guarda primero " & padre.DisplayName)
                Continue For
            End If
            If (System.IO.File.GetAttributes(padre.FullFileName) And System.IO.FileAttributes.ReadOnly) = System.IO.FileAttributes.ReadOnly Then
                errores.Add(oc.Name & ": " & padre.DisplayName & " es de solo lectura (Vault)")
                Continue For
            End If
            Dim clave As String = src.FullFileName & "|" & padre.FullFileName
            If Not hechos.ContainsKey(clave) Then
                Dim nuevo As String = CrearPersonalizado(cc, src, padre)
                hechos(clave) = nuevo
                lineas.Add("  " & System.IO.Path.GetFileNameWithoutExtension(src.FullFileName) & "  ->  " & System.IO.Path.GetFileName(nuevo))
            End If
            oc.Replace(hechos(clave), False)
            nRemp += 1
        Catch ex As Exception
            errores.Add(oc.Name & ": " & ex.Message)
        End Try
    Next
    Try
        top.Update()
    Catch
    End Try

    Dim msg As String = nRemp & " perfiles pasados a la obra (" & hechos.Count & " piezas nuevas):" & vbCrLf & String.Join(vbCrLf, lineas.ToArray())
    If errores.Count > 0 Then msg &= vbCrLf & vbCrLf & "REVISAR:" & vbCrLf & String.Join(vbCrLf, errores.ToArray())
    msg &= vbCrLf & vbCrLf & "Guarda el ensamble y corre TEKLA_NUMERACION."
    If Not silencioso Then MessageBox.Show(msg, "PERFIL_A_OBRA")
End Sub

Private silencioso As Boolean

' Miembro personalizado de la misma familia / fila / longitud, en <ensamble>\Piezas\<ENS>-PF-nnn.ipt
Function CrearPersonalizado(cc As ContentCenter, src As PartDocument, padre As AssemblyDocument) As String

    Dim carpeta As String = System.IO.Path.Combine(CarpetaHija(padre), "Piezas")
    System.IO.Directory.CreateDirectory(carpeta)
    Dim nomP As String = System.IO.Path.GetFileNameWithoutExtension(padre.FullFileName)
    Dim n As Integer = 1
    Dim ruta As String
    Do
        ruta = System.IO.Path.Combine(carpeta, nomP & "-PF-" & n.ToString("000") & ".ipt")
        If Not System.IO.File.Exists(ruta) AndAlso Not Abierto(ruta) Then Exit Do
        n += 1
    Loop

    If Not src.ComponentDefinition.IsContentMember Then
        ' ya es personalizado: copia ordenada en la carpeta del conjunto
        src.SaveAs(ruta, True)
        Try
            System.IO.File.SetAttributes(ruta, System.IO.File.GetAttributes(ruta) And Not System.IO.FileAttributes.ReadOnly)
        Catch
        End Try
        Dim pc As Document = ThisApplication.Documents.Open(ruta, False)
        Try
            pc.PropertySets.Item("Design Tracking Properties").Item("Part Number").Value = System.IO.Path.GetFileNameWithoutExtension(ruta)
        Catch
        End Try
        For Each pn As String In New String() {"PROYECTO", "PLANTA", "COD_PROYECTO"}
            Dim v As String = UProp(padre, pn)
            If v <> "" Then EscribirProp(pc, pn, v)
        Next
        For Each pn As String In New String() {"MARCA", "MARCA_ANTERIOR", "CONJUNTO", "ENSAMBLE", "PADRE", "RUTA", "NIVEL", "PERTENECE_A"}
            If UProp(pc, pn) <> "" Then EscribirProp(pc, pn, "")
        Next
        EscribirProp(pc, "ORIGEN_CC", System.IO.Path.GetFileNameWithoutExtension(src.FullFileName))
        pc.Save()
        Return ruta
    End If

    Dim ps As PropertySet = src.PropertySets.Item("{B9600981-DEE8-4547-8D7C-E525B3A1727A}")
    Dim fid As String = CStr(ps.Item("FamilyId").Value)
    Dim mid As String = CStr(ps.Item("MemberId").Value)
    Dim fam As ContentFamily = CType(cc.GetContentObject("v3#" & fid & "#"), ContentFamily)
    Dim fila As ContentTableRow = CType(cc.GetContentObject("v3#" & fid & "#" & mid), ContentTableRow)
    ' longitud: la del estandar (en mm, la familia la convierte a sus unidades)
    Dim opts As NameValueMap = ThisApplication.TransientObjects.CreateNameValueMap()
    Try
        Dim lg As Double = src.ComponentDefinition.Parameters.Item("G_L").Value * 10
        opts.Add("B_L", lg.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture) & " mm")
    Catch
    End Try
    Dim razon As MemberManagerErrorsEnum
    Dim txt As String = ""
    Dim r As String = fam.CreateMember(fila, razon, txt, 54785, True, ruta, opts)
    If r Is Nothing OrElse r = "" OrElse Not System.IO.File.Exists(ruta) Then Throw New Exception("Content Center no creo la pieza personalizada (" & txt & ")")

    Dim p As Document = ThisApplication.Documents.Open(ruta, False)
    Try
        p.PropertySets.Item("Design Tracking Properties").Item("Part Number").Value = System.IO.Path.GetFileNameWithoutExtension(ruta)
    Catch
    End Try
    ' material del estandar (por si en la obra se cambio)
    Try
        CType(p, PartDocument).ActiveMaterial = src.ActiveMaterial
    Catch
    End Try
    For Each pn As String In New String() {"PROYECTO", "PLANTA", "COD_PROYECTO"}
        Dim v As String = UProp(padre, pn)
        If v <> "" Then EscribirProp(p, pn, v)
    Next
    EscribirProp(p, "ORIGEN_CC", System.IO.Path.GetFileNameWithoutExtension(src.FullFileName))
    p.Save()
    Return ruta
End Function

' Perfil de Content Center que hay que pasar a la obra:
'   - colocado en ESTANDAR (miembro de la biblioteca), o
'   - PERSONALIZADO pero fuera de <ensamble>\Piezas o sin el nombre en serie <ENS>-PF-nnn.
' No: perfiles de Frame Generator, perneria (sin G_L), piezas ya ordenadas.
Function EsPerfilCC(oc As ComponentOccurrence) As Boolean
    Try
        If oc.DefinitionDocumentType <> DocumentTypeEnum.kPartDocumentObject Then Return False
        Dim p As PartDocument = CType(oc.Definition.Document, PartDocument)
        Dim x As Double = 0
        Try
            x = p.ComponentDefinition.Parameters.Item("G_L").Value
        Catch
        End Try
        If x <= 0 Then Return False
        If p.ComponentDefinition.IsContentMember Then Return True
        If EsFG(p) Then Return False
        Dim padre As Document = Nothing
        Try
            padre = oc.Parent.Document
            If EsFG(padre) Then Return False
        Catch
        End Try
        Dim tieneCC As Boolean = False
        Try
            tieneCC = (CStr(p.PropertySets.Item("{B9600981-DEE8-4547-8D7C-E525B3A1727A}").Item("FamilyId").Value) <> "")
        Catch
        End Try
        If Not tieneCC OrElse padre Is Nothing Then Return False
        Dim carp As String = System.IO.Path.Combine(CarpetaHija(padre), "Piezas").ToLower()
        Dim nomP As String = System.IO.Path.GetFileNameWithoutExtension(padre.FullFileName).ToUpper()
        Dim ok As Boolean = System.IO.Path.GetDirectoryName(p.FullFileName).ToLower() = carp AndAlso _
            System.Text.RegularExpressions.Regex.IsMatch(System.IO.Path.GetFileNameWithoutExtension(p.FullFileName).ToUpper(), "^" & System.Text.RegularExpressions.Regex.Escape(nomP) & "-[A-Z]{1,4}-\d{2,4}$")
        Return Not ok
    Catch
        Return False
    End Try
End Function

Function EsFG(d As Document) As Boolean
    Try
        ' Solo el Frame (FrameDoc) y sus perfiles (FrameMemberDoc). Un conjunto que CONTIENE un
        ' Frame tambien tiene el interes de Frame Generator (SolveAssemblyDoc): ese no cuenta.
        For Each di As DocumentInterest In d.DocumentInterests
            If di.ClientId = "{AC211AE0-A7A5-4589-916D-81C529DA6D17}" AndAlso (di.Name = "FrameDoc" OrElse di.Name = "FrameMemberDoc") Then Return True
        Next
    Catch
    End Try
    Return False
End Function

Sub Juntar(occs As Object, l As List(Of ComponentOccurrence))
    For Each o As ComponentOccurrence In occs
        Try
            If o.Suppressed Then Continue For
            If o.DefinitionDocumentType = DocumentTypeEnum.kAssemblyDocumentObject Then
                Juntar(o.SubOccurrences, l)
            ElseIf EsPerfilCC(o) Then
                l.Add(Nativa(o))
            End If
        Catch
        End Try
    Next
End Sub

Function Nativa(o As ComponentOccurrence) As ComponentOccurrence
    Try
        If TypeOf o Is ComponentOccurrenceProxy Then Return CType(o, ComponentOccurrenceProxy).NativeObject
    Catch
    End Try
    Return o
End Function

Function Abierto(ruta As String) As Boolean
    For Each x As Document In ThisApplication.Documents
        If x.FullFileName.ToLower() = ruta.ToLower() Then Return True
    Next
    Return False
End Function

' Carpeta para los hijos de un ensamble: <carpeta>\<NOMBRE>\ ; una FASE que ya vive en su propia
' carpeta usa esa misma carpeta.
Function CarpetaHija(d As Document) As String
    Dim dir As String = System.IO.Path.GetDirectoryName(d.FullFileName)
    Dim nom As String = System.IO.Path.GetFileNameWithoutExtension(d.FullFileName)
    If UProp(d, "TIPO_ENSAMBLE").ToUpper() = "PLANTA" AndAlso System.IO.Path.GetFileName(dir).ToUpper() = nom.ToUpper() Then Return dir
    Return System.IO.Path.Combine(dir, nom)
End Function

Function Arg(n As String) As String
    Try
        If RuleArguments.Exists(n) Then Return CStr(RuleArguments.Value(n))
    Catch
    End Try
    Return ""
End Function

Function UProp(d As Document, n As String) As String
    Try
        Return CStr(d.PropertySets.Item("Inventor User Defined Properties").Item(n).Value).Trim()
    Catch
    End Try
    Return ""
End Function

Sub EscribirProp(d As Document, n As String, v As String)
    Dim ps As PropertySet = d.PropertySets.Item("Inventor User Defined Properties")
    Try
        ps.Item(n).Value = v
    Catch
        ps.Add(v, n)
    End Try
End Sub
